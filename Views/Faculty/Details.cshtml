@model Faculty
@{
    ViewData["Title"] = Model.Name;
}

<h1 class="mb-3">@Model.Name</h1>

<div class="row g-4 mb-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FacultyCode)</dt>
                    <dd class="col-sm-8 font-monospace">@Model.FacultyCode</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Name)</dt>
                    <dd class="col-sm-8">@Model.Name</dd>
                    <dt class="col-sm-4">Số sinh viên</dt>
                    <dd class="col-sm-8 mb-0">
                        @ViewBag.StudentCount
                        <a class="ms-2" asp-controller="Student" asp-action="Index" asp-route-facultyCode="@Model.FacultyCode">Xem danh sách</a>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Các ngành thuộc khoa</h2>
                @if (Model.Majors.Count == 0)
                {
                    <p class="text-muted mb-0">Chưa có ngành nào.</p>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var major in Model.Majors)
                        {
                            <li><span class="font-monospace">@major.MajorCode</span> - @major.Name</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.FacultyCode">Sửa</a>
<a class="btn btn-outline-secondary" asp-action="Index">← Danh sách</a>
