@model IEnumerable<Faculty>
<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(m => m.FacultyCode)</th>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th class="text-end">Số ngành</th>
            <th class="text-end">Số sinh viên</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="font-monospace">@item.FacultyCode</td>
                <td>@item.Name</td>
                <td class="text-end">@item.Majors.Count</td>
                <td class="text-end">@item.Students.Count</td>
                <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary" data-modal="@Url.Action("Details", new { id = item.FacultyCode })">Chi tiết</button>
                    <button class="btn btn-sm btn-outline-primary" data-modal="@Url.Action("Form", new { id = item.FacultyCode })">Sửa</button>
                    <button class="btn btn-sm btn-outline-danger" data-delete="@Url.Action("Delete", new { id = item.FacultyCode })" data-name="&quot;@item.Name&quot;">Xoá</button>
                </td>
            </tr>
        }
    </tbody>
</table>
