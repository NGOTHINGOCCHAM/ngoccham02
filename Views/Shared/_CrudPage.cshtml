@* Buổi 11-12: khung trang danh sách dùng chung: tìm kiếm, lọc, số dòng mỗi trang, nút Thêm, bảng nạp bằng Ajax *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <button class="btn btn-primary" data-modal="@Url.Action("Form")">+ Thêm @ViewData["Entity"]</button>
</div>
@if (ViewData["Hint"] is string hint)
{
    <p class="text-muted">@Html.Raw(hint)</p>
}

@* Buổi 12: các ô trong form này được gửi kèm mỗi lần tải bảng *@
<form id="filterForm" class="row g-2 align-items-center mb-3" role="search" autocomplete="off">
    <div class="col-sm-6 col-lg-4">
        <input type="search" name="q" class="form-control" placeholder="@(ViewData["SearchHint"] ?? "Tìm kiếm...")" aria-label="Tìm kiếm" />
    </div>
    @if (ViewData["FilterPartial"] is string filterPartial)
    {
        <partial name="@filterPartial" />
    }
    <div class="col-auto">
        <select name="pageSize" class="form-select" aria-label="Số dòng mỗi trang">
            @foreach (var size in DemoMVC.Helpers.PagedList<object>.PageSizeOptions)
            {
                <option value="@size" selected="@(size == DemoMVC.Helpers.PagedList<object>.DefaultPageSize)">@size dòng / trang</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm</button>
    </div>
</form>

<div id="tableContainer" data-url="@Url.Action("List")">
    <div class="text-center text-muted py-5">Đang tải dữ liệu...</div>
</div>
