@model IEnumerable<Product>
@{
    ViewData["Title"] = ViewData["Heading"];
}

<h1 class="mb-3">@ViewData["Heading"]</h1>
<p class="text-muted">
    <code>ProductController</code> dùng <code>[Route("san-pham")]</code>. Các link bên dưới tạo bằng tag helper
    <code>asp-action</code> nên tự sinh đúng URL theo attribute route.
</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-primary btn-sm" asp-action="Index">/san-pham</a>
    <a class="btn btn-outline-primary btn-sm" asp-action="Category" asp-route-category="laptop">/san-pham/danh-muc/laptop</a>
    <a class="btn btn-outline-primary btn-sm" asp-action="Category" asp-route-category="dien-thoai">/san-pham/danh-muc/dien-thoai</a>
    <a class="btn btn-outline-primary btn-sm" asp-action="Sale">/khuyen-mai</a>
    <a class="btn btn-outline-primary btn-sm" asp-action="Newest">/san-pham/Newest</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary">Không có sản phẩm nào.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th class="text-end">Giá</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>
                        @p.Name
                        @if (p.OnSale)
                        {
                            <span class="badge text-bg-danger">Sale</span>
                        }
                    </td>
                    <td><a asp-action="Category" asp-route-category="@p.Category">@p.Category</a></td>
                    <td class="text-end">@p.Price.ToString("N0") ₫</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary" asp-action="Detail" asp-route-id="@p.Id">Chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
