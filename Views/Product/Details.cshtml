@model Product
@{
    ViewData["Title"] = Model.Name;
}

<h1 class="mb-3">Chi tiết sản phẩm</h1>

<div class="row">
    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Name)</dt>
                    <dd class="col-sm-8">@Model.Name</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Price)</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("#,##0.##") ₫</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
                    <dd class="col-sm-8 mb-0">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
<a class="btn btn-outline-secondary" asp-action="Index">← Danh sách</a>
