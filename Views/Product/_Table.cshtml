@model DemoMVC.Helpers.PagedList<Product>
@if (!Model.Any())
{
    <div class="alert alert-secondary">@(string.IsNullOrEmpty(Model.Keyword) ? "Chưa có sản phẩm nào. Bấm \"Thêm sản phẩm\" để tạo mới." : $"Không tìm thấy kết quả nào khớp với \"{Model.Keyword}\".")</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameForInnerType((Product m) => m.Name)</th>
                <th class="text-end">@Html.DisplayNameForInnerType((Product m) => m.Price)</th>
                <th>@Html.DisplayNameForInnerType((Product m) => m.CreatedAt)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-end">@item.Price.ToString("#,##0.##") ₫</td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-secondary" data-modal="@Url.Action("Details", new { id = item.Id })">Chi tiết</button>
                        <button class="btn btn-sm btn-outline-primary" data-modal="@Url.Action("Form", new { id = item.Id })">Sửa</button>
                        <button class="btn btn-sm btn-outline-danger" data-delete="@Url.Action("Delete", new { id = item.Id })" data-name="sản phẩm &quot;@item.Name&quot;">Xoá</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<partial name="_Pager" model="Model" />
