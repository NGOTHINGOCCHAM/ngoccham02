@model Product
@{
    Layout = "_ModalForm";
    ViewData["Entity"] = "sản phẩm";
    ViewData["IsEdit"] = Model.Id != 0;
}
<input type="hidden" asp-for="Id" />
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Price" class="form-label"></label>
    <div class="input-group">
        <input asp-for="Price" class="form-control" type="number" step="any" />
        <span class="input-group-text">₫</span>
    </div>
    <span asp-validation-for="Price" class="text-danger"></span>
</div>
@if (Model.Id != 0)
{
    <p class="text-muted small mb-0">Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") (không thay đổi khi sửa)</p>
}
