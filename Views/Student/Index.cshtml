@{
    ViewData["Title"] = "Sinh viên";
    ViewData["SearchHint"] = "Tìm theo mã SV, họ tên, email...";
    ViewData["Entity"] = "sinh viên";
    ViewData["FilterPartial"] = "_FacultyFilter";
}

<partial name="_CrudPage" />

@section Scripts {
    <script>
        // Xem trước mã sinh viên trong modal: mỗi khi đổi năm, hệ hoặc ngành thì hỏi action NextCode
        (function () {
            const url = '@Url.Action("NextCode")';

            async function updateNextCode() {
                const output = document.getElementById('next-code');
                if (!output) return;
                const params = new URLSearchParams({
                    enrollmentYear: $('#EnrollmentYear').val(),
                    trainingSystemCode: $('#TrainingSystemCode').val(),
                    majorCode: $('#MajorCode').val()
                });
                try {
                    const data = await (await fetch(url + '?' + params)).json();
                    output.textContent = data.code ?? 'chọn đủ năm nhập học, hệ và ngành';
                } catch {
                    output.textContent = '...';
                }
            }

            $(document).on('change', '#crudModal .code-part', updateNextCode);
            $('#crudModal').on('form-loaded', updateNextCode);
        })();
    </script>
}
