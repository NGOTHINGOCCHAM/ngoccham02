@model DemoMVC.Helpers.PagedList<Student>
@if (!Model.Any())
{
    <div class="alert alert-secondary">@(string.IsNullOrEmpty(Model.Keyword) ? "Chưa có sinh viên nào. Bấm \"Thêm sinh viên\" để tạo mới." : $"Không tìm thấy kết quả nào khớp với \"{Model.Keyword}\".")</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameForInnerType((Student m) => m.StudentCode)</th>
                    <th>@Html.DisplayNameForInnerType((Student m) => m.FullName)</th>
                    <th>@Html.DisplayNameForInnerType((Student m) => m.DateOfBirth)</th>
                    <th>@Html.DisplayNameForInnerType((Student m) => m.Faculty)</th>
                    <th>@Html.DisplayNameForInnerType((Student m) => m.Major)</th>
                    <th>@Html.DisplayNameForInnerType((Student m) => m.TrainingSystem)</th>
                    <th>@Html.DisplayNameForInnerType((Student m) => m.EnrollmentYear)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="font-monospace">@item.StudentCode</td>
                        <td>@item.FullName</td>
                        <td>@item.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                        <td>@item.Faculty?.Name</td>
                        <td>@item.Major?.Name</td>
                        <td>@item.TrainingSystem?.Name</td>
                        <td>@item.EnrollmentYear</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" data-modal="@Url.Action("Details", new { id = item.Id })">Chi tiết</button>
                            <button class="btn btn-sm btn-outline-primary" data-modal="@Url.Action("Form", new { id = item.Id })">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger" data-delete="@Url.Action("Delete", new { id = item.Id })" data-name="sinh viên &quot;@item.FullName&quot; (@item.StudentCode)">Xoá</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<partial name="_Pager" model="Model" />
