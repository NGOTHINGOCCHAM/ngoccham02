@model Student
@{
    ViewData["Title"] = "Xoá sinh viên";
}

<h1 class="mb-3">Xoá sinh viên</h1>
<div class="alert alert-warning">Bạn có chắc muốn xoá sinh viên này?</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.StudentCode)</dt>
                    <dd class="col-sm-8 font-monospace">@Model.StudentCode</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FullName)</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Major)</dt>
                    <dd class="col-sm-8">@Model.Major?.Name</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Faculty)</dt>
                    <dd class="col-sm-8 mb-0">@Model.Faculty?.Name</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xoá</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Huỷ</a>
</form>
