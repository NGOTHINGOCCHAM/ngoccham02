@model Major
@{
    Layout = "_ModalForm";
    ViewData["Entity"] = "ngành";
    var isEdit = (bool)(ViewData["IsEdit"] ?? false);
}
<input type="hidden" name="isEdit" value="@isEdit.ToString().ToLower()" />
<div class="mb-3">
    <label asp-for="MajorCode" class="form-label"></label>
    <input asp-for="MajorCode" class="form-control font-monospace" maxlength="2" readonly="@isEdit" />
    <span asp-validation-for="MajorCode" class="text-danger"></span>
    @if (isEdit) { <div class="form-text">Mã ngành là khoá chính nên không sửa được.</div> }
</div>
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="FacultyCode" class="form-label"></label>
    <select asp-for="FacultyCode" asp-items="ViewBag.Faculties" class="form-select">
        <option value="">-- Chọn khoa --</option>
    </select>
    <span asp-validation-for="FacultyCode" class="text-danger"></span>
    @if (isEdit) { <div class="form-text">Đổi khoa thì các sinh viên của ngành cũng chuyển sang khoa mới.</div> }
</div>
