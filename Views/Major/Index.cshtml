@model IEnumerable<Major>
@{
    ViewData["Title"] = "Ngành";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Ngành</h1>
    <a class="btn btn-primary" asp-action="Create">+ Thêm ngành</a>
</div>
<p class="text-muted">Mã ngành gồm 2 chữ số, là phần thứ ba của mã sinh viên. Mỗi ngành thuộc một khoa.</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">Chưa có ngành nào. Bấm "Thêm ngành" để tạo mới.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(m => m.MajorCode)</th>
                <th>@Html.DisplayNameFor(m => m.Name)</th>
                <th>@Html.DisplayNameFor(m => m.FacultyCode)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="font-monospace">@item.MajorCode</td>
                    <td>@item.Name</td>
                    <td>
                        <a asp-controller="Faculty" asp-action="Details" asp-route-id="@item.FacultyCode">@item.Faculty?.Name</a>
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.MajorCode">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.MajorCode">Xoá</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
