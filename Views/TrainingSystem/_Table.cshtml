@model DemoMVC.Helpers.PagedList<TrainingSystem>
@if (!Model.Any())
{
    <div class="alert alert-secondary">@(string.IsNullOrEmpty(Model.Keyword) ? "Chưa có hệ đào tạo nào." : $"Không tìm thấy kết quả nào khớp với \"{Model.Keyword}\".")</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameForInnerType((TrainingSystem m) => m.TrainingSystemCode)</th>
                <th>@Html.DisplayNameForInnerType((TrainingSystem m) => m.Name)</th>
                <th class="text-end">Số sinh viên</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="font-monospace">@item.TrainingSystemCode</td>
                    <td>@item.Name</td>
                    <td class="text-end">@item.Students.Count</td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-primary" data-modal="@Url.Action("Form", new { id = item.TrainingSystemCode })">Sửa</button>
                        <button class="btn btn-sm btn-outline-danger" data-delete="@Url.Action("Delete", new { id = item.TrainingSystemCode })" data-name="hệ &quot;@item.Name&quot;">Xoá</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<partial name="_Pager" model="Model" />
