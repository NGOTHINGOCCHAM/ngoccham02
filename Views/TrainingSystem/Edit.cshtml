@model TrainingSystem
@{
    ViewData["Title"] = "Sửa hệ đào tạo";
}

<h1 class="mb-3">Sửa hệ đào tạo</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="TrainingSystemCode" class="form-label"></label>
                @* Mã hệ là khoá chính nên không cho sửa. Ô readonly vẫn được gửi lên cùng form *@
                <input asp-for="TrainingSystemCode" class="form-control font-monospace" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Huỷ</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
