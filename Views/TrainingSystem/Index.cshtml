@model IEnumerable<TrainingSystem>
@{
    ViewData["Title"] = "Hệ đào tạo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Hệ đào tạo</h1>
    <a class="btn btn-primary" asp-action="Create">+ Thêm hệ đào tạo</a>
</div>
<p class="text-muted">Mã hệ gồm 2 chữ số, là phần thứ hai của mã sinh viên.</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">Chưa có hệ đào tạo nào. Bấm "Thêm hệ đào tạo" để tạo mới.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(m => m.TrainingSystemCode)</th>
                <th>@Html.DisplayNameFor(m => m.Name)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="font-monospace">@item.TrainingSystemCode</td>
                    <td>@item.Name</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.TrainingSystemCode">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.TrainingSystemCode">Xoá</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
